package config

import (
	"errors"
	"os"
	"path/filepath"
	"testing"

	. "github.com/smartystreets/goconvey/convey"
)

func TestLoad(t *testing.T) {
	Convey("加载项目配置", t, func() {
		dir := t.TempDir()

		Convey("数据库默认关闭", func() {
			So(os.WriteFile(filepath.Join(dir, "conf.yaml"), []byte("database: {}\n"), 0o600), ShouldBeNil)

			cfg, err := load(dir, "conf")

			So(err, ShouldBeNil)
			So(cfg.Database.MySQL.Enabled, ShouldBeFalse)
			So(cfg.Database.Redis.Enabled, ShouldBeFalse)
		})

		Convey("读取 MySQL 和 Redis 配置", func() {
			content := "database:\n" +
				"  mysql:\n    enabled: true\n    dsn: mysql-dsn\n" +
				"  redis:\n    enabled: true\n    addr: 127.0.0.1:6379\n"
			So(os.WriteFile(filepath.Join(dir, "conf.yaml"), []byte(content), 0o600), ShouldBeNil)

			cfg, err := load(dir, "conf")

			So(err, ShouldBeNil)
			So(cfg.Database.MySQL.DSN, ShouldEqual, "mysql-dsn")
			So(cfg.Database.Redis.Addr, ShouldEqual, "127.0.0.1:6379")
		})

		Convey("环境变量覆盖 YAML 配置", func() {
			const enabledKey = "{{.EnvPrefix}}_DATABASE_MYSQL_ENABLED"
			const dsnKey = "{{.EnvPrefix}}_DATABASE_MYSQL_DSN"
			previousEnabled, enabledExists := os.LookupEnv(enabledKey)
			previousDSN, dsnExists := os.LookupEnv(dsnKey)
			Reset(func() {
				So(restoreEnv(enabledKey, previousEnabled, enabledExists), ShouldBeNil)
				So(restoreEnv(dsnKey, previousDSN, dsnExists), ShouldBeNil)
			})

			So(os.WriteFile(filepath.Join(dir, "conf.yaml"), []byte("database: {}\n"), 0o600), ShouldBeNil)
			t.Setenv(enabledKey, "true")
			t.Setenv(dsnKey, "env-mysql-dsn")

			cfg, err := load(dir, "conf")

			So(err, ShouldBeNil)
			So(cfg.Database.MySQL.Enabled, ShouldBeTrue)
			So(cfg.Database.MySQL.DSN, ShouldEqual, "env-mysql-dsn")
		})

		Convey("启用 MySQL 时必须配置 DSN", func() {
			content := "database:\n  mysql:\n    enabled: true\n"
			So(os.WriteFile(filepath.Join(dir, "conf.yaml"), []byte(content), 0o600), ShouldBeNil)

			_, err := load(dir, "conf")

			So(errors.Is(err, ErrMySQLDSNRequired), ShouldBeTrue)
		})

		Convey("启用 Redis 时必须配置地址", func() {
			content := "database:\n  redis:\n    enabled: true\n"
			So(os.WriteFile(filepath.Join(dir, "conf.yaml"), []byte(content), 0o600), ShouldBeNil)

			_, err := load(dir, "conf")

			So(errors.Is(err, ErrRedisAddrRequired), ShouldBeTrue)
		})
	})
}

func restoreEnv(key, value string, exists bool) error {
	if exists {
		return os.Setenv(key, value)
	}
	return os.Unsetenv(key)
}
