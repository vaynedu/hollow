package control

import (
	"context"

	"github.com/vaynedu/hollow/pkg/hlog"

	"{{.ModuleName}}/proto"
	"{{.ModuleName}}/service"
)

// Health 返回服务健康状态。
func (Control) Health(ctx context.Context, _ *proto.HealthRequest) (*proto.HealthResponse, error) {
	logger := hlog.FromContext(ctx).Named("Health")
	status, err := service.Health(ctx)
	if err != nil {
		logger.Error("health check failed", hlog.Err(err))
		return nil, err
	}
	return &proto.HealthResponse{Status: status}, nil
}
